print("================================")
print("      AUTOMATIC SCORING SYSTEM")
print("================================")
questions = [
    ("1. What is the capital of India?", "Delhi"),
    ("2. Which language is used for Python programming?", "Python"),
    ("3. What is 10 + 5?", "15"),
    ("4. What is the extension of a Python file?", ".py"),
    ("5. Which keyword is used to define a function in Python?", "def")
]
score = 0
for question, answer in questions:
    print("\n" + question)
    user_answer = input("Your answer: ")
    if user_answer.lower() == answer.lower():
        print("Correct!")
        score += 1
    else:
        print("Wrong! Correct answer:", answer)
print("\n================================")
print("           FINAL RESULT")
print("================================")
print("Total Questions:", len(questions))
print("Correct Answers:", score)
print("Wrong Answers:", len(questions) - score)
print("Final Score:", score, "/", len(questions))
percentage = (score / len(questions)) * 100
print("Percentage:", percentage, "%")
if percentage >= 50:
    print("Result: PASS")
else:
    print("Result: FAIL")
print("================================")

